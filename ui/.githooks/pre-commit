#!/usr/bin/env bash
# ==============================================================================
# GeoAI Git Pre-Commit Hook - Test-Driven & Zero-Latency Enforcement Gate
# ==============================================================================
# Blocks any commit touching UI Python files if:
#   1. Newly added or modified files in `ui/` lack matching test definitions.
#   2. Static AST zero-latency invariants are violated.
#   3. Any unit test or millisecond latency ceiling regresses.
#
# Install via:
#   git config core.hooksPath .githooks
# ==============================================================================
set -e

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_DIR="$(cd "$HOOK_DIR/.." && pwd)"
cd "$WORKSPACE_DIR"

if [ -x "../.venv/Scripts/python.exe" ]; then
    PYTHON_EXE="../.venv/Scripts/python.exe"
elif [ -x ".venv/Scripts/python.exe" ]; then
    PYTHON_EXE=".venv/Scripts/python.exe"
elif [ -x "../.venv/bin/python" ]; then
    PYTHON_EXE="../.venv/bin/python"
elif [ -x ".venv/bin/python" ]; then
    PYTHON_EXE=".venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON_EXE="python3"
else
    PYTHON_EXE="python"
fi

echo "[GeoAI Pre-Commit Gate] Validating test coverage, AST invariants, and latency ceilings..."
"$PYTHON_EXE" verify_quality_gate.py
