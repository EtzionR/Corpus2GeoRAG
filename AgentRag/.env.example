# TEMPLATE ONLY - do NOT put your key in this file, it is committed to git.
# Copy it to .env (same folder) and fill in .env instead - .env is gitignored.

# Your OWN OpenRouter API key - everyone who runs the agent uses their own.
# Create one at https://openrouter.ai/keys (the free models this project uses cost nothing).
# Alternatively, leave this empty and pass api_key=... to query().
OPENROUTER_API_KEY=

# Optional: where the knowledge graph lives. Default: ../Graph_n_Geocoding/knowledge_graph.json
# GRAPH_PATH=
